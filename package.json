{
  "name": "nusashell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --filter='./plugins/*' run build && pnpm -r --filter='./packages/*' run build",
    "prebuild": "pnpm scan:ui-docs",
    "scan:ui-docs": "node scripts/scan-ui-docs.mjs",
    "test": "vitest run",
    "test:frontend": "vitest run --project=@nusashell/desktop",
    "test:backend": "vitest run --project=!@nusashell/desktop",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "desktop:dev": "pnpm --filter @nusashell/desktop run dev",
    "desktop:make": "pnpm --filter @nusashell/desktop run make",
    "desktop:publish": "pnpm --filter @nusashell/desktop run publish"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
