{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app.js",
    "tests/**/*.test.mjs",
    "tests/register.mjs",
    "tests/loader.mjs"
  ],
  "project": [
    "lib/**/*.js",
    "components/**/*.js",
    "tests/**/*.{js,mjs}"
  ],
  "paths": {
    "/vendor/*": ["./vendor/*"]
  },
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
