{
  "name": "nusashell-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Electron wrapper for the NusaShell web application",
  "author": {
    "name": "Jahrulnr",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/jahrulnr/NusaShell",
  "desktopName": "nusashell-desktop",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/main.cjs",
  "scripts": {
    "start": "node src/dev.cjs",
    "dev": "node src/dev.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/run-electron-ui.cjs",
    "package:dir": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.7",
    "playwright-core": "1.62.1"
  },
  "build": {
    "appId": "com.jahrulnr.nusashell",
    "productName": "NusaShell Desktop",
    "executableName": "nusashell-desktop",
    "artifactName": "NusaShell-Electron-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/icons/icon-512.png",
        "to": "nusashell.png"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "icon": "../../frontend/icons/icon-512.png",
      "category": "Utility",
      "maintainer": "NusaShell Maintainers <noreply@github.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "../../frontend/icons/icon-512.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "../../frontend/icons/icon-512.png",
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
